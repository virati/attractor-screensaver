[Unit]
Description=Strange attractor screensaver
PartOf=graphical-session.target

[Service]
Type=simple
# Placement comes from the window rules install.sh writes, matched on the
# --class each instance is launched with.
ExecStart=%h/Projects/attractor-screensaver/bin/attractors --idle --all-displays
# SIGTERM goes to the launcher alone so its own cleanup can run in order.
KillMode=mixed
TimeoutStopSec=20
# Belt and braces. Flatpak runs the browser in its own systemd scope, not in
# this unit's cgroup, so if the launcher is ever killed outright rather than
# stopped, nothing else would reap the windows and they would pile up across
# idle cycles. The leading - means a miss is not an error.
ExecStopPost=-/usr/bin/pkill -x chrome -f /tmp/attractors-profile-
Restart=no
